# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# sesuaikan user dan password nya
DATABASE_URL="postgresql://user:password@localhost:5432/ecatalog"
JWT_SECRET="secret-key"

# ============================================
# E-Catalog — Docker Compose Environment
# ============================================
# Copy this file to `.env` and adjust values for your environment.
# All variables have sensible defaults in docker-compose.yml.
# ============================================

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
# ganti password nya
POSTGRES_PASSWORD=
POSTGRES_DB=ecatalog

# ── Backend ───────────────────────────────────
JWT_SECRET=change-me-in-production
RUN_MIGRATIONS=true

# ── Port Mapping ──────────────────────────────
# Change these if the default ports conflict on your host
FRONTEND_PORT=80
BACKEND_EXTERNAL_PORT=3000
DB_EXTERNAL_PORT=5432