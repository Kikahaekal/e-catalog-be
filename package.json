{
  "name": "e-catalog-be",
  "private": true,
  "packageManager": "npm@11.6.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "nodemon --watch src --exec tsx src/index.ts",
    "dev:composer": "npm run build && npm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/composer": "0.23.0",
    "@prisma/composer-prisma-cloud": "0.23.0",
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "alchemy": "2.0.0-beta.78",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.8",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.17",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.115"
  }
}
