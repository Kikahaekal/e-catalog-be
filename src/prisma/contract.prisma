enum Role {
  ADMIN
  SUPER_ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model IucnStatus {
  id      Int       @id @default(autoincrement())
  code    String    @unique
  name    String
  species Species[]
}

model Species {
  id             BigInt   @id @default(autoincrement())
  scientificName String   @unique
  commonName     String

  author         String?
  etymology      String?
  order          String?
  family         String?
  genus          String?

  environment      String?
  climateZone      String?
  depthMinMeters   Int?
  depthMaxMeters   Int?
  tempMinC         Float?
  tempMaxC         Float?
  distributionText String?

  maxLengthCm    Float?
  lengthType     String?
  maxWeightKg    Float?
  maxAgeYears    Float?
  dorsalSpines   String?
  dorsalSoftRays String?
  analSpines     String?
  analSoftRays   String?
  bodyShape      String?
  morphologyText String?

  biologyText    String?
  fecundityText  String?
  threatToHumans String?

  fisheriesImportance String?
  isGamefish          Boolean @default(false)

  iucnStatusId    Int?
  iucnStatus      IucnStatus?        @relation(fields: [iucnStatusId], references: [id])
  iucnAssessedAt  DateTime?
  citesStatus     String?
  cmsStatus       String?

  synonyms   Synonym[]
  references SpeciesReference[]
  localNames LocalName[]
  photos     SpeciesPhoto[]
  regencies  SpeciesRegency[]
  wppZones   SpeciesWppZone[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Synonym {
  id             BigInt  @id @default(autoincrement())
  speciesId      BigInt
  species        Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  scientificName String
  author         String?
  status         String?
}

model Reference {
  id        BigInt             @id @default(autoincrement())
  refCode   Int?               @unique
  authors   String
  year      Int?
  title     String
  source    String?
  species   SpeciesReference[]
}

model SpeciesReference {
  speciesId   BigInt
  species     Species   @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  referenceId BigInt
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  isMainRef   Boolean   @default(false)

  @@id([speciesId, referenceId])
}

model LocalName {
  id         BigInt  @id @default(autoincrement())
  speciesId  BigInt
  species    Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name       String
  regionNote String?
}

model Regency {
  id       Int              @id @default(autoincrement())
  name     String
  province String
  species  SpeciesRegency[]
}

model SpeciesRegency {
  speciesId BigInt
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  regencyId Int
  regency   Regency @relation(fields: [regencyId], references: [id], onDelete: Cascade)

  @@id([speciesId, regencyId])
}

model WppZone {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String?
  species     SpeciesWppZone[]
}

model SpeciesWppZone {
  speciesId BigInt
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  wppZoneId Int
  wppZone   WppZone @relation(fields: [wppZoneId], references: [id], onDelete: Cascade)

  @@id([speciesId, wppZoneId])
}

model SpeciesPhoto {
  id        BigInt  @id @default(autoincrement())
  speciesId BigInt
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  filePath  String
  caption   String?
  isPrimary Boolean @default(false)
}

model UserSubmission {
  id            BigInt   @id @default(autoincrement())
  submittedName String
  photoFilePath String
  locationNote  String?
  submitterName String?
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()
}